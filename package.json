{
  "name": "face-h5-public",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Privacy-first browser face framing and short video capture reference",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:http",
    "dev:http": "node scripts/dev-servers.mjs --http-only",
    "dev:https": "node scripts/dev-servers.mjs --https-only",
    "dev:all": "node scripts/dev-servers.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.mjs && node scripts/audit.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304"
  },
  "devDependencies": {
    "vite": "8.3.0"
  }
}
